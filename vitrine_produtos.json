        "https://www.amazon.com.br/dp/B08C1W5N87",
        "https://www.amazon.com.br/dp/B082PSNGN4",
        # ... cole aqui até 50 links de Tecnologia ...
    ],
    "Casa": [
        "https://www.amazon.com.br/dp/B08Q2W1X4K",
        "https://www.amazon.com.br/dp/B07N2W1X4K",
        # ... cole aqui até 50 links de Casa ...
    ],
    "Fitness": [
        "https://www.amazon.com.br/dp/B07L5D9X5T",
        "https://www.amazon.com.br/dp/B085V7W1QX",
        # ... cole aqui até 50 links de Fitness ...
    ],
    "Pets": [
        "https://www.amazon.com.br/dp/B07P4V8X2M",
        "https://www.amazon.com.br/dp/B083W2V1X4",
        # ... cole aqui até 50 links de Pets ...
    ]
}

if __name__ == "__main__":
    produtos_vitrine = []
    id_atual = 1

    print("🚀 Iniciando extração automática de fotos e títulos...")
    
    for nicho, links in LINKS_POR_NICHO.items():
        print(f"\n--- Processando Nicho: {nicho.upper()} ---")
        for link in links:
            dados = extrair_dados_automaticamente(link, nicho, id_atual)
            if dados:
                produtos_vitrine.append(dados)
                id_atual += 1

    # Salva o arquivo JSON final para o seu site
    with open("vitrine_produtos.json", "w", encoding="utf-8") as f:
        json.dump(produtos_vitrine, f, ensure_ascii=False, indent=2)

    print(f"\n✨ SUCESSO! Arquivo 'vitrine_produtos.json' gerado com {len(produtos_vitrine)} produtos com imagens e títulos reais!")
