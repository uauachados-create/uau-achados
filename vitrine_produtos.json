import json
import re
import requests
from bs4 import BeautifulSoup
from datetime import datetime

# =========================================================
# SUAS TAGS DE AFILIADO
# =========================================================
TAG_AMAZON = "032018011983-20"
TAG_MERCADO_LIVRE = "18735177"

# Cabecalho para o site achar que é um navegador real (evita bloqueios)
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
    "Accept-Language": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7"
}

def extrair_dados_automaticamente(url, nicho, id_produto):
    """
    Entra no link do produto, puxa a FOTO REAL e o TÍTULO sozinho!
    """
    try:
        print(f"🤖 Lendo produto #{id_produto}: {url[:45]}...")
        resposta = requests.get(url, headers=HEADERS, timeout=10)
        soup = BeautifulSoup(resposta.text, "html.parser")

        # 1. Tenta pegar a foto oficial pela tag OpenGraph do site
        imagem = None
        tag_img = soup.find("meta", property="og:image") or soup.find("meta", attrs={"name": "twitter:image"})
        if tag_img and tag_img.get("content"):
            imagem = tag_img["content"]
        else:
            # Imagem de segurança caso o site bloqueie a leitura
            imagem = "https://via.placeholder.com/500x500?text=Foto+Indisponivel"

        # 2. Tenta pegar o título oficial do produto
        titulo = "Produto em Oferta"
        tag_titulo = soup.find("meta", property="og:title") or soup.find("title")
        if tag_titulo:
            titulo_texto = tag_titulo.get("content", "") or tag_titulo.text
            # Limpa o texto tirando "| Amazon" ou "- Mercado Livre"
            titulo = re.sub(r"(\||-).*?(Amazon|Mercado Livre|MercadoLivre).*", "", titulo_texto, flags=re.I).strip()

        # 3. Identifica a origem e gera o link de afiliado automaticamente
        origem = "Amazon" if "amazon.com" in url else "Mercado Livre"
        if origem == "Amazon":
            separador = "&" if "?" in url else "?"
            link_afiliado = f"{url}{separador}tag={TAG_AMAZON}"
        else:
            separador = "&" if "?" in url else "?"
            link_afiliado = f"{url}{separador}matt_tool={TAG_MERCADO_LIVRE}"

        return {
            "id": id_produto,
            "titulo": titulo,
            "preco": 0.00, # Os sites exigem API paga para preço ao vivo; clique no site exibe o preço real
            "imagem": imagem,
            "origem": origem,
            "nicho": nicho,
            "link_vitrine": link_afiliado
        }

    except Exception as erro:
        print(f"⚠️ Erro ao ler produto #{id_produto}: {erro}")
        return None

# =========================================================
# LISTA AUTOMÁTICA DE LINKS (COLE APENAS OS LINKS DO PRODUTO AQUI)
# =========================================================
# Para ter 50 por nicho (200 no total), basta colar os links que você
# quer divulgar aqui dentro da categoria correspondente:

